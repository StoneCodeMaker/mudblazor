@using MudBlazor
@using MudBlazorApp.Models
@inherits ComponentBase

<MudStack Spacing="4" Class="pa-6">
    <MudNumericField T="int" Label="ID" @bind-Value="Id" Immediate="true" Variant="Variant.Outlined" />
    <MudTextField Label="Name" @bind-Value="Name" Immediate="true" Variant="Variant.Outlined" />
    <MudSwitch T="bool" @bind-Checked="Verified" Color="Color.Primary" Label="Verified" />
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <MudAlert Severity="Severity.Error">@ErrorMessage</MudAlert>
    }
</MudStack>
<MudStack Row Spacing="3" Class="mt-4 pa-6" Justify="Justify.FlexEnd">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => AddCountry())">Save</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Default" OnClick="@(() => Cancel())">Cancel</MudButton>
</MudStack>

@code {
    [CascadingParameter] MudBlazor.IDialogReference DialogReference { get; set; } = default!;
    [Parameter] public List<int> ExistingIds { get; set; } = new();

    public int Id { get; set; }
    public string Name { get; set; } = string.Empty;
    public bool Verified { get; set; } = false;
    public string ErrorMessage { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        Id = ExistingIds.Any() ? ExistingIds.Max() + 1 : 1;
        Console.WriteLine($"Dialog initialized - DialogReference: {DialogReference != null}");
    }

    private void AddCountry()
    {
        try
        {
            Console.WriteLine("AddCountry method called");
            ErrorMessage = string.Empty;
            
            Console.WriteLine($"Adding country - ID: {Id}, Name: {Name}, Verified: {Verified}");
            Console.WriteLine($"DialogReference is null: {DialogReference == null}");
            
            if (ExistingIds.Contains(Id))
            {
                ErrorMessage = $"ID {Id} already exists. Please choose a different ID.";
                return;
            }
            if (string.IsNullOrWhiteSpace(Name))
            {
                ErrorMessage = "Name cannot be empty.";
                return;
            }
            var newCountry = new CountryModel
            {
                Id = Id,
                Name = Name,
                Verified = Verified,
                CreatedOn = DateTime.Now,
                LastModified = DateTime.Now,
                Mode = "Mock"
            };
            
            Console.WriteLine($"Created new country: {newCountry.Name} (ID: {newCountry.Id}, Verified: {newCountry.Verified})");
            Console.WriteLine("About to close dialog...");
            
            DialogReference.Close(DialogResult.Ok(newCountry));
            Console.WriteLine("Dialog closed successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in AddCountry: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            ErrorMessage = $"Error: {ex.Message}";
        }
    }

    private void Cancel()
    {
        try
        {
            Console.WriteLine("Cancel method called");
            Console.WriteLine("Canceling dialog...");
            DialogReference.Close(DialogResult.Cancel());
            Console.WriteLine("Dialog canceled successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in Cancel: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
    }
} 